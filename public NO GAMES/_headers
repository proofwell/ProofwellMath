# Security headers (Netlify reads this file automatically)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Only the site's own pages may be put inside a frame by this site.
# (Not set on /games/* — Firefox blocks locked-down game frames when this header is on them.)
/
  Content-Security-Policy: frame-ancestors 'self'
/index.html
  Content-Security-Policy: frame-ancestors 'self'
/signin
  Content-Security-Policy: frame-ancestors 'self'
/signin.html
  Content-Security-Policy: frame-ancestors 'self'
/chat
  Content-Security-Policy: frame-ancestors 'self'
/chat.html
  Content-Security-Policy: frame-ancestors 'self'
/math
  Content-Security-Policy: frame-ancestors 'self'
/math.html
  Content-Security-Policy: frame-ancestors 'self'
/modpanel
  Content-Security-Policy: frame-ancestors 'self'
/modpanel.html
  Content-Security-Policy: frame-ancestors 'self'
